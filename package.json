{
  "name": "simple-node-server",
  "version": "1.0.0",
  "description": "A simple Node.js server",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm server.ts",
    "start:prod": "node dist/main.js",
    "start:debug": "node --loader ts-node/esm --inspect-brk server.ts",
    "prestart:prod": "npm run build",
    "heroku-postbuild": "npm run build"
  },
  "keywords": [
    "node",
    "server",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-express": "^11.1.12",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.2",
    "nanoid": "^5.1.6",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.5.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.9",
    "ts-node": "^10.9.2"
  },
  "ts-node": {
    "esm": true
  }
}
